    "@tiptap/extension-image": "^3.33.0",
    "@tiptap/extension-list": "^3.33.0",
    "@tiptap/extension-paragraph": "^3.33.0",
    "@tiptap/pm": "^3.33.0",
    "@tiptap/starter-kit": "^3.33.0",
    "@tiptap/vue-3": "^3.33.0",
    "chart.js": "^4.6.1",
    "d3": "^7.9.0",
    "dayjs": "^1.11.23",
    "dompurify": "^3.4.17",
    "pinia": "^4.0.3",
    "tailwindcss": "^4.2.4",
    "topojson-client": "^3.1.0",
    "vue": "^3.5.32",
    "vue-chartjs": "^5.3.4",
    "vue-i18n": "^11.4.18",
    "vue-router": "^5.3.0",
    "world-atlas": "^2.0.2"
